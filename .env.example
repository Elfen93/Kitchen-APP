# Copy to .env.local for `vercel dev`, or set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Required for "Generate recipes". Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model used for recipe generation (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional but recommended: only accept API calls from your own site (comma-separated)
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Optional: community recipes. Any Upstash-compatible Redis REST endpoint.
# (Vercel's Redis/KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: donation links shown on the About page (hidden when empty)
# VITE_KOFI_URL=https://ko-fi.com/yourname
# VITE_PAYPAL_URL=https://paypal.me/yourname
