# Copy to .env.local for local runs, or set these in Render / Vercel. Never commit real values.

# Required for "Generate recipes". Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model used for recipe generation (default: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: community recipes. A Postgres connection string — Neon works out of the box.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Recommended: only accept API calls from your own site (comma-separated)
# ALLOWED_ORIGIN=https://kaimono-cook.onrender.com

# Optional: donation links on the About page (hidden when empty). Needed at build time.
# VITE_KOFI_URL=https://ko-fi.com/yourname
# VITE_PAYPAL_URL=https://paypal.me/yourname
